# 필수 — 이것만 있으면 서버가 뜬다
DATABASE_URL=postgres://user:password@host:5432/dbname
SSL_MODE=require

# 이하 전부 선택. 없으면 해당 기능만 비활성화되고 서버는 정상 기동한다.

HOST=0.0.0.0
SYSTEM_CODE=your_system_code

# 메일 — 관리자 알림, 비밀번호 재설정에 사용
MAIL_USER=admin@example.com          # 알림을 받을 관리자 주소
MAIL_FROM=noreply@example.com        # 발신 주소
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx   # https://resend.com

# 결제 (토스페이먼츠) — 크레딧 충전에 사용
TOSS_SECRET_KEY=
NEXT_PUBLIC_TOSS_CLIENT_KEY=
PAYMENT_RETURN_PATH=/mainPages/userAccount

# 크레딧
CREDIT_WON_PER_CREDIT=10             # 결제 금액(원) → 크레딧 환산 비율
CREDIT_STARTER=0                     # 신규 가입 시 지급 크레딧 (0이면 미지급)

# OpenAI — 채팅 AI 이모지·음성인식, eDoc 텍스트 생성에 사용
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Redis — 다중 인스턴스에서 소켓 동기화. 단일 인스턴스면 불필요
REDIS_URL=

# --- 그 외 ---
# 메일 수신 관리자 주소

# Resend API (https://resend.com)

# 트랜잭션 이력 제외 사용자 (콤마 구분)
TXN_HISTORY_EXCLUDED_USERS=admin,your_admin_id

# 미설정 시 OpenAI로 자동 폴백
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5

# 우선순위: Claude → Gemini → OpenAI. Claude가 막히면 Gemini가 받는다.
# 키 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

AIC_CREDIT_STARTER=100            # 신규 스타터 크레딧
AIC_IMAGE_CREDIT_COST=20         # 이미지 1장당 크레딧(fal FLUX ₩200)
AIC_BYOK_IMAGE_CREDIT_COST=4     # BYOK 이미지 1장당 플랫폼 크레딧
AIC_ADMIN_USER_IDS=              # 크레딧 수동 지급 허용 관리자 userId(쉼표 구분)
# 토스페이먼츠 (미설정 시 충전 버튼은 '준비중'). 테스트 키로도 동작
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_xxxxxxxxxxxx
TOSS_SECRET_KEY=test_sk_xxxxxxxxxxxx

# Knowledge Vault (n8n 임베딩 API 보호용, 선택)
KNOWLEDGE_VAULT_API_KEY=your_secret_key_here
# Knowledge Vault GitHub 접근 (private repo 읽기용 Personal Access Token)
GITHUB_TOKEN=ghp_your_github_token_here
KNOWLEDGE_VAULT_REPO=SIM-HYUNBO/knowledge-vault

# DB
DATABASE_URL=postgres://user:password@host:port/dbname
SSL_MODE=require
DB_POOL_MAX=10
DB_CONNECTION_POOL_MAX=10
CHAT_DB_POOL_MAX=3
DB_STARTUP_POOL_MAX=1

# Web Push (VAPID) - npx web-push generate-vapid-keys 로 생성
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
PUSH_JOB_CONCURRENCY=2
PUSH_SEND_CONCURRENCY=5

# 채팅 메시지 AES-256-GCM 암호화 키 (임의 문자열, 32자 이상 권장)
APP_ENCRYPTION_KEY=your_chat_encryption_key_here
DB_SCHEMA=brunner
